# Zerodha Kite Connect Credentials
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret

# Zerodha Login Credentials for Automated TOTP Login
KITE_USER_ID=your_zerodha_user_id
KITE_PASSWORD=your_zerodha_password
KITE_TOTP_SECRET=your_zerodha_totp_secret_key

# Email Report Settings
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
REPORT_RECIPIENT=your@gmail.com

# Trading mode: paper or live
TRADING_MODE=paper

# Capital management
MAX_DEPLOY_PCT=0.5        # Max % of portfolio to deploy at once (0.5 = 50%)
DAILY_SPEND_CAP=999999    # Max currency to spend per day

# --- UK growth investing bot (uk_growth_bot/) -------------------------------
# Off unless enabled on the host:  COMPOSE_PROFILES=uk
UK_TRADING_MODE=paper            # sim = no broker | paper = Trading 212 practice account | live = real money
UK_BROKER=trading212             # trading212 (API key, unattended) | ibkr (needs daily 2FA)
UK_ACCOUNT_TYPE=isa              # isa (tax-free) | gia (taxable; CGT engine steers sales)
# Trading 212 API key + secret (Settings > API in the app). Live mode only.
T212_ENV=demo                    # only used with UK_TRADING_MODE=live; live = real money
T212_API_KEY=
T212_API_SECRET=
UK_MONTHLY_CONTRIBUTION=200      # sim/paper: credited each month; live: deposit this yourself
UK_CONTRIBUTION_DAY=1
UK_INCOME_TAX_BAND=basic         # basic | higher | additional (GIA only)
UK_REGIME_ACTION=pause           # pause | derisk | ignore (bear-market behaviour)
UK_CORE_FUNDS=3                  # core ETFs held, picked by rank from the pool in universe.py
UK_CORE_EXIT_RANK=5              # a held core fund is replaced only when it ranks below this
UK_CORE_MIN_HOLD_DAYS=90         # ...and has been held at least this long
UK_SELL_ONLY_IN_PROFIT=true      # rotations/rebalances never sell below average cost (crash rule exempt)
UK_MIN_SALE_PROFIT_PCT=0.01      # ...and must beat it by this margin
UK_REPORT_RECIPIENT=your@gmail.com
# --- India growth investing bot (in_growth_bot/, Zerodha; uses the KITE_* settings above) ---
IN_TRADING_MODE=sim              # sim (real prices, pretend money) | live (real Zerodha orders)
IN_MONTHLY_CONTRIBUTION=25000    # INR you transfer into Zerodha each month
IN_CONTRIBUTION_DAY=1
IN_POSITIONS=8                   # shares held, at most IN_MAX_PER_SECTOR per sector
IN_MAX_PER_SECTOR=2
IN_INCLUDE_ETFS=false            # Indian ETFs: UK taxes their gains as income (not CGT)
IN_UK_INCOME_TAX_BAND=           # defaults to UK_INCOME_TAX_BAND
IN_REPORT_RECIPIENT=             # defaults to UK_REPORT_RECIPIENT / REPORT_RECIPIENT
# IBKR route only (also add uk-ibkr to COMPOSE_PROFILES):
# IBEAM_ACCOUNT=your_ibkr_username
# IBEAM_PASSWORD=your_ibkr_password
